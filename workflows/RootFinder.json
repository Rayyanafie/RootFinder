      "parameters": {
        "jsCode": "// 1. Get the text map from Gemini (which is directly connected to this node)\nconst geminiRaw = $input.all()[0].json.content.parts[0].text;\n\n// Clean it up (removes markdown formatting if Gemini added it) and parse it into an object\nconst map = JSON.parse(geminiRaw.replace(/```json|```/g, '').trim());\n\n// 2. REACH BACK and grab the 50+ rows from your Extraction node!\n// ⚠️ IMPORTANT: If your extract node has a different name, change it here:\nconst allData = $items(\"Extract from XLSX\"); \n\nlet result = [];\n\n// 3. Loop through all original rows\nfor (let i = 0; i < allData.length; i++) {\n  let item = allData[i].json;\n  \n  // Standardize the columns based on what Gemini figured out\n  item.ReviewTextOriginal = item[map.text_column];\n  item.ReviewRateStars = Number(item[map.rating_column]);\n  \n  // If they provided an ID, use it. If not, invent one!\n  item.ReviewId = map.id_column ? item[map.id_column] : `auto_gen_${i}`;\n  \n  result.push({ json: item });\n}\n\n// 4. Output the full list of standardized rows\nreturn result;"
      },
